# 9Router environment contract
# Lokal (Laragon/Windows) jalan pakai SQLite tanpa env Supabase.
# Vercel/production wajib set Supabase agar data tidak hilang (filesystem ephemeral).

# ── Supabase / Postgres (wajib di Vercel, opsional lokal) ──────────────
# DATABASE_URL = connection string Postgres Supabase.
# Ambil di: Supabase Dashboard > Project Settings > Database > Connection string
# Ganti [YOUR-PASSWORD] dengan password DB yang kamu set saat create project.
# Untuk Vercel/serverless PAKAI pooling port 6543 (+ ?pgbouncer=true):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   ^ host pooler mengikuti region project kamu — jangan tebak, copy dari
#     Supabase Dashboard > Project Settings > Database > Connection string (Transaction pooler).
#     Direct db.<ref>.supabase.co:5432 sering ENETUNREACH di build Vercel (IPv6)
#     dan tanpa pgbouncer cepat max_connections.
# Lokal/dev boleh pakai direct 5432 jika suka, tapi 6543 juga jalan.
# Alias yang didukung: DATABASE_URL | POSTGRES_URL | POSTGRES_URL_NON_POOLING | SUPABASE_DB_URL | SUPABASE_DATABASE_URL
# Jika tidak di-set atau masih placeholder [YOUR-PASSWORD], app fallback ke SQLite.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres
# Alternatif pooling (disarankan untuk Vercel — copy dari Supabase "Transaction pooler"):
# DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Vercel Cron (opsional tapi disarankan) ──────────────────────────────
# Vercel otomatis set VERCEL=1. CRON_SECRET dipakai untuk mengamankan /api/cron/refresh-tokens.
# Generate: openssl rand -hex 32  (atau: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Set nilai yang sama di Vercel Dashboard > Settings > Environment Variables.
# Jika tidak di-set, cron tetap jalan tapi tanpa auth (aman untuk dev, kurang untuk prod).
CRON_SECRET=
# Token yang dipakai custom-server.js & middleware untuk membuktikan x-9r-real-ip valid.
# Di Vercel set agar login rate-limit pakai IP asli (jika kosong, middleware pakai fallback).
NINEROUTER_PEER_TOKEN=

# ── Supabase publishable (opsional, tidak dipakai untuk DB utama) ───────
# Publishable key (sb_publishable_...) dipakai kalau nanti ada fitur client-side Supabase.
# Untuk 9vercel saat ini TIDAK wajib — DB lewat DATABASE_URL di atas (postgres.js).
# Jika butuh service_role (server-side Supabase JS), ambil di Project Settings > API Keys.
# (jangan commit nilai asli key ke repo — copy dari dashboard saat dibutuhkan)
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Required
JWT_SECRET=change-me-to-a-long-random-secret
# Password login dashboard pertama (sebelum hash tersimpan di DB).
# Jika dikosongkan / tidak di-set -> fallback ke default bawaan 9Router "123456"
# (login dengan itu, lalu ganti di Dashboard -> Profile/Settings).
INITIAL_PASSWORD=change-me
# DATA_DIR hanya untuk self-host / lokal. Di Vercel JANGAN set (pakai Supabase).
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
